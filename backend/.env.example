ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional override; defaults to claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5
DB_ENCRYPTION_KEY=your-secure-encryption-key-here

# Code-enforced guardrails are on by default. Set to false only for the
# intentionally vulnerable prompt-only baseline demo.
GUARDRAILS_ENABLED=true

# When true, a request may send {"guardrails_enabled": false} to switch this
# one request to the prompt-only baseline. Keep false outside demos.
ALLOW_DEMO_TOGGLE=false

# Optional Google Chat/Slack webhook for escalated guardrail anomalies.
# ANOMALY_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/...

# Optional tuning (defaults shown).
# GUARDRAIL_MAX_MESSAGE_CHARS=1500
# GUARDRAIL_MAX_HISTORY_TURNS=20
# GUARDRAIL_MAX_HISTORY_CHARS=8000
# GUARDRAIL_RATE_LIMIT_REQUESTS=20
# GUARDRAIL_RATE_LIMIT_CHARS=30000
# GUARDRAIL_RATE_LIMIT_WINDOW_SECONDS=60
# GUARDRAIL_TOPIC_SIMILARITY_THRESHOLD=0.20
# GUARDRAIL_MAX_TICKETS_PER_SESSION=2
